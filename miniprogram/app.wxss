page{background:#f5f3ec;color:#263d31;font-family:-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;box-sizing:border-box}view,button,input,text,scroll-view{box-sizing:border-box}button{font-size:28rpx;border-radius:12rpx;line-height:1.4;padding:25rpx 24rpx;font-weight:500;margin:0}button::after{border:none}button[disabled]{opacity:.42}button.primary{background:#163e34;color:#fff}button.secondary{background:transparent;color:#163e34;border:1rpx solid #bdc9b0}button.text-button{background:transparent;padding:16rpx 0;color:#49613e;font-size:24rpx;font-weight:400}button.close{padding:4rpx 16rpx;color:#65755c;background:transparent;font-size:44rpx;line-height:1}.page{padding:22rpx 40rpx 30rpx;padding-bottom:calc(30rpx + env(safe-area-inset-bottom))}.muted{color:#7f8a74;font-size:25rpx;line-height:1.8}.hint{font-size:22rpx;color:#909b84;line-height:1.7}.label{font-size:23rpx;color:#7f8d71}.button-row{display:flex;gap:20rpx}.button-row button{flex:1}.error{padding:18rpx 22rpx;background:#f1e1d8;border-radius:10rpx;color:#a24b34;font-size:24rpx;line-height:1.7;margin:18rpx 0}.footer{display:flex;justify-content:space-between;border-top:1rpx solid #dce2d2;margin-top:38rpx;padding-top:24rpx;font-size:20rpx;color:#919d82}.overlay{position:fixed;inset:0;z-index:100;background:rgba(19,42,29,.48);display:flex;align-items:center;justify-content:center;padding:28rpx}.sheet{width:100%;max-width:650rpx;background:#fbfaf4;border-radius:24rpx;padding:36rpx;max-height:90vh;display:flex;flex-direction:column}.sheet-heading{display:flex;align-items:center;justify-content:space-between;font-size:36rpx;font-weight:600;margin-bottom:26rpx;flex-shrink:0}.sheet-body{max-height:65vh;min-height:0;flex-shrink:1;margin-bottom:24rpx}.field{margin:25rpx 0;font-size:26rpx}.field>text{display:block;margin-bottom:16rpx}.picker-value{display:flex;justify-content:space-between;border:1rpx solid #ccd5bf;padding:22rpx;border-radius:8rpx;font-size:27rpx}.switch-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;font-size:25rpx;margin:20rpx 0}.switch-row switch{transform:scale(.85);transform-origin:right center}.section-title{font-family:serif;font-size:44rpx;margin:26rpx 0}.A{color:#5586ae}.B{color:#b7824c}.empty{padding:75rpx 0;text-align:center}.empty .muted{margin-top:25rpx}.empty button{margin-top:35rpx}.full{width:100%}
